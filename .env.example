# Copy to .env for local development. Never commit .env.
#
# First run scripts/bootstrap_local_db.sh (needs a Postgres superuser locally,
# e.g. `PGHOST=localhost PGUSER=<superuser> ./scripts/bootstrap_local_db.sh`)
# to create the roles and databases these URLs point at.

SOFTBOX_ENVIRONMENT=local
SOFTBOX_DEBUG=true
SOFTBOX_LOG_LEVEL=INFO
# Human-readable at a terminal; use json everywhere a log aggregator reads.
SOFTBOX_LOG_FORMAT=console

# The application connects as the NON-OWNER role so row-level security
# applies to it (D3). Loaded via app.bootstrap.settings.Settings.
SOFTBOX_DATABASE_URL=postgresql+asyncpg://softbox_app:softbox_app_dev_only@localhost:5432/softbox

SOFTBOX_CORS_ORIGINS=["http://localhost:5173"]

# ── Migrations & tests ──────────────────────────────────────────────────────
# Read directly by migrations/env.py and tests/infrastructure/conftest.py via
# os.environ, never through Settings above - the owner credential must never
# be a value the application itself is capable of loading.
SOFTBOX_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://softbox_owner:softbox_owner_dev_only@localhost:5432/softbox
SOFTBOX_TEST_OWNER_DATABASE_URL=postgresql+asyncpg://softbox_owner:softbox_owner_dev_only@localhost:5432/softbox_test
SOFTBOX_TEST_APP_DATABASE_URL=postgresql+asyncpg://softbox_app:softbox_app_dev_only@localhost:5432/softbox_test
