# Copy to .env for local development. Never commit .env.
#
# First run scripts/bootstrap_local_db.sh (needs a Postgres superuser locally,
# e.g. `PGHOST=localhost PGUSER=<superuser> ./scripts/bootstrap_local_db.sh`)
# to create the roles and databases these URLs point at.

SOFTBOX_ENVIRONMENT=local
SOFTBOX_DEBUG=true
SOFTBOX_LOG_LEVEL=INFO
# Human-readable at a terminal; use json everywhere a log aggregator reads.
SOFTBOX_LOG_FORMAT=console

# The application connects as the NON-OWNER role so row-level security
# applies to it (D3). Loaded via app.bootstrap.settings.Settings.
SOFTBOX_DATABASE_URL=postgresql+asyncpg://softbox_app:softbox_app_dev_only@localhost:5432/softbox

SOFTBOX_CORS_ORIGINS=["http://localhost:5173"]

# ── Migrations & tests ──────────────────────────────────────────────────────
# Read directly by migrations/env.py and tests/infrastructure/conftest.py via
# os.environ, never through Settings above - the owner credential must never
# be a value the application itself is capable of loading.
SOFTBOX_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://softbox_owner:softbox_owner_dev_only@localhost:5432/softbox
SOFTBOX_TEST_OWNER_DATABASE_URL=postgresql+asyncpg://softbox_owner:softbox_owner_dev_only@localhost:5432/softbox_test
SOFTBOX_TEST_APP_DATABASE_URL=postgresql+asyncpg://softbox_app:softbox_app_dev_only@localhost:5432/softbox_test

# ── Email ────────────────────────────────────────────────────────────────
# Unprefixed env vars are invisible to Settings (env_prefix="SOFTBOX_",
# extra="ignore") - every real setting needs the prefix, so these are named
# to match rather than the unprefixed names first sketched out.
# "console" logs instead of sending; switch to "smtp" once SOFTBOX_SMTP_* is
# a real app-password credential, never the placeholder below.
SOFTBOX_EMAIL_BACKEND=console
SOFTBOX_SMTP_HOST=smtp.gmail.com
SOFTBOX_SMTP_PORT=587
SOFTBOX_SMTP_USER=bharathsethu18@gmail.com
SOFTBOX_SMTP_PASSWORD=replace-with-a-real-gmail-app-password
SOFTBOX_EMAIL_FROM=BabySarees <bharathsethu18@gmail.com>

# ── Google SSO (D4, /api/v1/auth/*) ────────────────────────────────────────
# From a Google Cloud OAuth client (type "Web application") - register
# {your frontend origin}/auth/callback (or wherever the SPA's callback page
# lives) as an authorised redirect URI. Empty by default: the app boots and
# every other route works with these unset, but /auth/google/* will fail
# against Google (not silently - the exchange fails loudly with an
# AuthenticationError) until real values are set.
SOFTBOX_GOOGLE_CLIENT_ID=id
SOFTBOX_GOOGLE_CLIENT_SECRET=replace-with-a-real-google-oauth-client-secret

# Explicit platform-admin bootstrap allowlist (D4) - anyone logging in with
# one of these emails is granted platform_admin if they don't already have
# it. JSON array, matching SOFTBOX_CORS_ORIGINS's format.
SOFTBOX_ADMIN_EMAILS=["bharathsethu18@gmail.com"]