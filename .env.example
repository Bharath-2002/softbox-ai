# Copy to .env for local development. Never commit .env.

SOFTBOX_ENVIRONMENT=local
SOFTBOX_DEBUG=true
SOFTBOX_LOG_LEVEL=INFO
# Human-readable at a terminal; use json everywhere a log aggregator reads.
SOFTBOX_LOG_FORMAT=console

# The application connects as a NON-OWNER role so row-level security applies
# to it (D3). Migrations run as the owner role, which is a different URL.
SOFTBOX_DATABASE_URL=postgresql+asyncpg://softbox_app:softbox_app@localhost:5432/softbox

SOFTBOX_CORS_ORIGINS=["http://localhost:5173"]
